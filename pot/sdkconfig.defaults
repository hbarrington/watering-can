# M5Stack Unit PoE-P4 (ESP32-P4, RISC-V). This chip needs its own
# toolchain (riscv32-esp-elf) -- run `install.sh esp32p4` (or `install.sh all`)
# once on whichever machine builds this project if it's not already there.
CONFIG_IDF_TARGET="esp32p4"

# Matches M5Stack's own factory-firmware defaults for this board: the
# Unit PoE-P4 uses silicon rev >= v3.0, which needs this explicitly set.
# (Source: m5stack/M5Unit-PoE-P4-UserDemo sdkconfig.p4x.defaults)
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y

# Board has 16MB flash (confirmed via hardware_bom.md / M5Stack's specs).
# Without this, the build defaults to assuming 2MB, which still boots fine
# for a binary this small but under-reports capacity (seen on first boot:
# "Detected size(16384k) larger than the size in the binary image header
# (2048k). Using the size in the binary image header.") and will matter
# once Ethernet/sensors/OTA grow the binary.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Ethernet bring-up (Phase 2): internal EMAC + IP101 PHY over the Unit
# PoE-P4's RJ45/PoE port, via the same protocol_examples_common helper
# src/ uses for WiFi (example_connect() dispatches to Ethernet when this
# is selected instead of CONFIG_EXAMPLE_CONNECT_WIFI).
CONFIG_EXAMPLE_CONNECT_WIFI is not set
CONFIG_EXAMPLE_CONNECT_ETHERNET=y
CONFIG_EXAMPLE_USE_INTERNAL_ETHERNET=y
CONFIG_EXAMPLE_ETH_PHY_IP101=y

# MDC/MDIO/PHY-reset: these match the esp32p4 defaults already built into
# ESP-IDF (ETH_ESP32_EMAC_DEFAULT_CONFIG() in esp_eth_mac_esp.h) *and*
# M5Stack's docs pin table in hardware_bom.md -- set explicitly here so
# they don't silently drift if upstream Kconfig defaults ever change.
CONFIG_EXAMPLE_ETH_MDC_GPIO=31
CONFIG_EXAMPLE_ETH_MDIO_GPIO=52
CONFIG_EXAMPLE_ETH_PHY_RST_GPIO=51

# NOT independently confirmed for this board -- just the example's
# generic default. First thing to try if the PHY isn't found/link never
# comes up.
CONFIG_EXAMPLE_ETH_PHY_ADDR=1
